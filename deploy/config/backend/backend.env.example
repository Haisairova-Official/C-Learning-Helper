# Production MariaDB; replace placeholders in /etc/c-assist/backend.env, mode 0600.
DB_URL=jdbc:mariadb://127.0.0.1:3306/c_assist
DB_USERNAME=c_assist
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
SESSION_COOKIE_SECURE=true
# Do not enable the demo profile in production.
JUDGE_ENABLED=true
JUDGE_BASE_URL=http://127.0.0.1:5050
JUDGE_TOKEN=REPLACE_WITH_JUDGE_TOKEN
# Opt in to DeepSeek by setting AI_MODE=deepseek and a real backend-only key.
# The school-hosted protocol remains a separate future adapter.
AI_MODE=disabled
DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_API_KEY=REPLACE_WITH_PRIVATE_KEY
